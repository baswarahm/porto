---
import SectionHead from './SectionHead.astro';
import { degree, commits, courses } from '../data/courses';
import { degreeProgress, textBar } from '../lib/degree';
import { buildGraph } from '../lib/gitgraph';

const { pct, semesters } = degreeProgress();
const rows = buildGraph(commits);
const laneClass = (l: number | null) => (l ? `c${l}` : undefined);
---
<section id="progress" aria-labelledby="progress-h">
  <div class="wrap">
    <SectionHead n="01" title="Degree progress" note="computed live from today's date" id="progress-h" />
    <div class="degree">
      <div class="sem-track" id="semTrack">
        {semesters.map(s => (
          <div class={`sem ${s.state}`} data-sem={s.index}>
            <div class="lbl">{s.state === 'now' ? '● now' : `sem ${s.index + 1}`}</div>
            <div class="yr">{s.label}</div>
            <div class="fill" style={`width:${(s.fill * 100).toFixed(1)}%`}></div>
          </div>
        ))}
      </div>
      <div class="degree-foot">
        <span>{degree.name} · {degree.start.slice(0, 4)} → {degree.end.slice(0, 4)}</span>
        <span data-degree-bar><span class="mono">{textBar(pct)}</span> <b>{(pct * 100).toFixed(1)}%</b></span>
      </div>
    </div>

    <div class="spacer"></div>
    <SectionHead n="git log" title="What I've learned" note="every course is a branch · it merges into main when I pass" small />
    <div class="gl-tools" id="glTools" role="group" aria-label="Filter by course">
      <button class="chip" type="button" aria-pressed="true" data-f="all">all</button>
      {courses.map(c => <button class="chip" type="button" aria-pressed="false" data-f={c.lane}><i class={`c${c.lane}`}>●</i> {c.code === 'SELF' ? 'self-study' : c.code}</button>)}
    </div>
    <div class="gitlog" role="list">
      {rows.map(r => (
        <div class="gl-row" role={r.kind === 'commit' ? 'listitem' : undefined} aria-hidden={r.kind === 'fork' ? 'true' : undefined} data-b={r.lane}>
          <span class="g">{r.cells.map((c, i) => <>{i > 0 && ' '}<span class={laneClass(c.lane)}>{c.ch}</span></>)}</span>
          {r.commit && <>
            <span class="h">{r.commit.hash}</span>
            <span class="m">{r.commit.msg}</span>
            {r.commit.ref && <span class="ref">({r.commit.ref})</span>}
            <span class="d">{r.commit.date}</span>
          </>}
        </div>
      ))}
    </div>
  </div>
</section>
