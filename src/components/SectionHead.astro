---
interface Props { eyebrow: string; title: string; id: string; desc?: string; center?: boolean }
const { eyebrow, title, id, desc, center = false } = Astro.props;
---
<div class:list={['section-head', 'reveal', { 'section-head-center': center }]}>
  <p class="section-eyebrow">{eyebrow}</p>
  <h2 class="section-title" id={id}>{title}</h2>
  {desc && <p class="section-desc">{desc}</p>}
</div>
