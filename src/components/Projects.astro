---
import SectionHead from './SectionHead.astro';
import Showcase from './Showcase.astro';
import Icon from './Icon.astro';
import { projects } from '../data/projects';
---
<section id="projects" aria-labelledby="projects-h">
  <div class="wrap">
    <SectionHead n="04" title="Projects" note="things I've built · tap to open" id="projects-h" />
    <div class="list reveal anim-unfold">
      {projects.map((p, i) => (
        <details class="item project" data-pill>
          <summary>
            <span class="y">{String(i + 1).padStart(2, '0')} · {p.year}</span>
            <span>
              <span class="t">{p.title}</span>
              {p.access && <span class="usm-tag"><Icon name="lock" size={12} />usm students only</span>}
              {p.maintenance && <span class="usm-tag maint"><Icon name="tool" size={12} />under maintenance</span>}
              <p class="d">{p.description}</p>
            </span>
            <span class="s">{p.stack}</span>
          </summary>
          <div class="more">
            <ul>{p.details.map(d => <li>{d}</li>)}</ul>
            <div class="more-actions">
              {p.showcase && <button class="btn primary" type="button" data-showcase={p.slug}><Icon name="play" size={16} />take the tool tour · {p.showcase.tools.length} tools</button>}
              {p.href && !p.maintenance && <a class="btn" href={p.href} target="_blank" rel="noopener noreferrer">open {p.title.toLowerCase()} ↗</a>}
              {p.maintenance && <span class="maint-note"><Icon name="tool" size={14} />{p.maintenance}</span>}
              {p.access && <a class="btn" href={p.access.href} target="_blank" rel="noopener noreferrer"><Icon name="instagram" size={16} />{p.access.cta} for access</a>}
            </div>
          </div>
        </details>
      ))}
      <div class="item next-slot">
        <span class="y">{String(projects.length + 1).padStart(2, '0')} · next</span>
        <span><span class="t">Next project loading<span class="dots"><i>.</i><i>.</i><i>.</i></span></span><p class="d">Probably something with data structures. If you have an idea, tell me below.</p></span>
        <span class="s">tbd</span>
      </div>
    </div>
  </div>
  {projects.filter(p => p.showcase).map(p => <Showcase project={p} />)}
</section>
