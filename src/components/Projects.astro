---
import SectionHead from './SectionHead.astro';
import { projects } from '../data/projects';
import { experience } from '../data/experience';
---
<section id="projects" aria-labelledby="projects-h">
  <div class="wrap">
    <SectionHead n="04" title="Projects" note="things I've shipped" id="projects-h" />
    <div class="list">
      {projects.map(p => {
        const Tag = p.href ? 'a' : 'div';
        return (
          <Tag class="item" href={p.href} target={p.href ? '_blank' : undefined} rel={p.href ? 'noopener noreferrer' : undefined}>
            <span class="y">{p.year}</span>
            <span><span class="t">{p.title}</span><p class="d">{p.description}</p></span>
            <span class="s">{p.stack}</span>
          </Tag>
        );
      })}
    </div>

    <div class="spacer"></div>
    <SectionHead n="before uni" title="Earlier" small />
    <div class="list">
      {experience.map(e => (
        <div class="item">
          <span class="y">{e.date}</span>
          <span><span class="t">{e.title}</span><p class="d">{e.org}</p></span>
          <span class="s">{e.tag}</span>
        </div>
      ))}
    </div>
  </div>
</section>
