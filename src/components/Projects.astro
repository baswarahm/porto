---
import SectionHead from './SectionHead.astro';
import Brackets from './Brackets.astro';
import { projects } from '../data/projects';
---
<section class="section container" id="projects" aria-labelledby="projects-heading">
  <SectionHead eyebrow="// Shipped & Building" title="Projects" id="projects-heading"
    desc="Small, real things — built to learn and actually used." />

  <div class="build-grid">
    {projects.map(p => (
      <article class="build-card panel bracket-frame reveal" data-tilt>
        <Brackets />
        <span class="build-status mono">{p.status}</span>
        <h3 class="build-title">{p.title}</h3>
        <p class="build-desc">{p.description}</p>
        <div class="build-tags">{p.tags.map(t => <span class="build-tag">{t}</span>)}</div>
        {(p.live || p.repo) && (
          <div class="build-links">
            {p.live && <a class="build-link mono" href={p.live} target="_blank" rel="noopener noreferrer">Live demo →</a>}
            {p.repo && <a class="build-link mono" href={p.repo} target="_blank" rel="noopener noreferrer">Source →</a>}
          </div>
        )}
      </article>
    ))}
  </div>

  <div class="build-cta-row reveal">
    <p>More on the way — and it's always a good time to build something together.</p>
    <a href="#contact" class="btn btn-primary" data-magnetic>Let's Collaborate</a>
  </div>
</section>
