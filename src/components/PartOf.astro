---
import { partOf } from '../data/profile';
---
<section class="section container beyond-journey reveal" id="journey" aria-labelledby="journey-heading">
  <h2 class="section-title" id="journey-heading">Part of</h2>

  <div class="beyond-journey-logos">
    {partOf.map(o => (
      <a href={o.href} target="_blank" rel="noopener noreferrer" class="beyond-journey-logo" aria-label={`${o.name} on Instagram`}>
        <img src={o.logo} alt={o.name} loading="lazy" width="96" height="96">
      </a>
    ))}
  </div>
</section>
