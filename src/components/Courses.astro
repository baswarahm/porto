---
import SectionHead from './SectionHead.astro';
import { courses } from '../data/courses';
import { degreeProgress } from '../lib/degree';

const { year, sem } = degreeProgress();
---
<section id="now" aria-labelledby="now-h">
  <div class="wrap">
    <SectionHead n="02" title="Taking now" note={`<span data-sem-label>year ${year}, semester ${sem}</span> · hover a course to light up its commits`} id="now-h" />
    <div class="courses">
      {courses.map((c, idx) => (
        <article class="course reveal anim-deal" data-lane={c.lane} style={`--i:${idx}`}>
          <div class="code"><span class={`c${c.lane}`}>{c.code}</span><span class="wk">{c.week ? `week ${c.week}/${c.weeks}` : 'ongoing'}</span></div>
          <h3>{c.name}</h3>
          {c.week && c.weeks && (
            <div class="weeks" style={`--n:${c.weeks}`} role="img" aria-label={`week ${c.week} of ${c.weeks}`}>
              {Array.from({ length: c.weeks }, (_, i) => <i class={i + 1 < c.week! ? 'on' : i + 1 === c.week ? 'cur' : undefined} style={`--i:${i}`}></i>)}
            </div>
          )}
          <ul>
            {c.learned.map(l => <li>{l}</li>)}
            {c.doing.map(l => <li class="doing">{l}</li>)}
          </ul>
          <p class="stuck">stuck on: {c.stuck}</p>
          <button type="button" class="go" data-lane={c.lane}>view commits ↑</button>
        </article>
      ))}
    </div>
  </div>
</section>
