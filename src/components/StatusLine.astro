<div class="cmdline" id="cmdline">
  <pre id="cmdOut" aria-live="polite"></pre>
  <form id="cmdForm"><span aria-hidden="true">:</span><input id="cmdInput" autocomplete="off" spellcheck="false" autocapitalize="off" aria-label="Command"></form>
</div>
<div class="status">
  <span class="mode" id="vMode">NORMAL</span>
  <span class="file" id="vFile">~/baswara/top.md</span>
  <span class="hint dim">j/k move · : command · x inspect</span>
  <span class="clock" id="vClock">penang --:--</span>
  <span class="pct dim" id="vPerf"></span>
  <button type="button" id="cmdBtn" class="touch-only" aria-label="Open command line">:</button>
  <button type="button" id="xrayBtn" aria-pressed="false" title="Inspect the page (x)">x-ray</button>
  <button type="button" id="bgBtn" aria-pressed="true" title="Toggle code background (b)">src bg</button>
  <span class="pct" id="vPct">Top</span>
</div>
<div class="xlabel" id="xlabel" aria-hidden="true"></div>
