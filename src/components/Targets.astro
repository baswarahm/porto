---
import SectionHead from './SectionHead.astro';
import { targets, targetColumns } from '../data/targets';

const labels = [...new Set(Object.values(targets).flat().map(t => t.label))];
---
<section id="targets" aria-labelledby="targets-h">
  <div class="wrap">
    <SectionHead n="03" title="Targets" note="tracked like issues · click one to see the checklist" id="targets-h" />
    <div class="t-tools" id="tTools" role="group" aria-label="Filter by label">
      <button class="chip" type="button" aria-pressed="true" data-l="all">all</button>
      {labels.map(l => <button class="chip" type="button" aria-pressed="false" data-l={l}>{l}</button>)}
    </div>
    <div class="targets reveal wipe">
      {targetColumns.map(col => (
        <div class={`col ${col.key}`}>
          <h3>{col.title}<span>{targets[col.key].length}</span></h3>
          {targets[col.key].map(t => {
            const done = t.steps.filter(s => s.done).length;
            const w = Math.round((done / t.steps.length) * 100);
            return (
              <details class="issue" data-l={t.label}>
                <summary>
                  <span class="ttl">{t.title}</span>
                  <span class="meta"><span class="lab">{t.label}</span><span>{t.due}</span><span>{done}/{t.steps.length}</span></span>
                  <span class="mini" style={`--w:${w}%`}><span></span></span>
                </summary>
                <ul>{t.steps.map(s => <li class:list={{ d: s.done }}>{s.text}</li>)}</ul>
              </details>
            );
          })}
        </div>
      ))}
    </div>
  </div>
</section>
