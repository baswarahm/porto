---
import type { Quest } from '../data/experience';
interface Props { quest: Quest }
const { quest } = Astro.props;
const done = quest.progress >= 100;
---
<div class="quest-entry panel reveal">
  <div class="quest-dot" aria-hidden="true"></div>
  <button class="quest-entry-btn" aria-expanded="false" aria-controls={quest.id}>
    <span class="quest-entry-main">
      <span class="quest-date mono">{quest.date}</span>
      <span class="quest-title-wrap">
        <span class="quest-title">{quest.title}</span>
        <span class="quest-org">{quest.org}</span>
      </span>
    </span>
    <span class:list={['quest-status', done ? 'completed' : 'inprogress']}>{done ? 'Completed' : 'In Progress'}</span>
    <svg class="quest-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </button>
  <div class="quest-body-outer"><div class="quest-body-inner">
    <p class="quest-body" id={quest.id}>{quest.body}</p>
    <div class="quest-progress"><div class="quest-progress-fill" style={`width:${quest.progress}%`}></div></div>
    {quest.progressLabel && <span class="quest-progress-label mono">{quest.progressLabel}</span>}
  </div></div>
</div>
