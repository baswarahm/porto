---
import SectionHead from './SectionHead.astro';
import { profile, socials } from '../data/profile';
---
<section id="contact" aria-labelledby="contact-h">
  <div class="wrap">
    <SectionHead n="06" title="Say hi" note='or press <span class="mono">:</span> and type <span class="mono">email</span>' id="contact-h" />
    <div class="contact">
      <a href={`mailto:${profile.email}`}>{profile.email}</a>
      {socials.map(s => <a href={s.href} target="_blank" rel="noopener noreferrer">{s.label}</a>)}
    </div>
  </div>
</section>
