---
import SectionHead from './SectionHead.astro';
import Icon from './Icon.astro';
import { profile, socials } from '../data/profile';
---
<section id="contact" aria-labelledby="contact-h">
  <div class="wrap">
    <SectionHead n="06" title="Say hi" note='or press <span class="mono">:</span> and type <span class="mono">email</span>' id="contact-h" />
    <div class="contact-card reveal anim-zoom">
      <div class="contact-main">
        <p class="avail" id="avail"><i aria-hidden="true"></i><span>checking Penang time…</span></p>
        <a class="email" href={`mailto:${profile.email}`}><Icon name="mail" size={28} />{profile.email}</a>
        <div class="contact-actions">
          <a class="btn primary" href={`mailto:${profile.email}`}><Icon name="mail" size={16} />write an email</a>
          <button class="btn" type="button" id="copyEmail"><Icon name="copy" size={16} />copy address</button>
          <button class="btn" type="button" id="vcard"><Icon name="contact" size={16} />save contact</button>
        </div>
      </div>
      <nav class="socials" aria-label="Elsewhere">
        {socials.map(s => (
          <a href={s.href} target="_blank" rel="noopener noreferrer" data-brand={s.icon}>
            <Icon name={s.icon} size={22} />
            <span class="s-txt"><b>{s.label}</b><small>{s.handle}</small></span>
            <Icon name="arrow" size={18} />
          </a>
        ))}
      </nav>
    </div>
  </div>
</section>
