---
/* A project's tool tour: a tab per tool across the top, the tool's
   screenshot in a window frame on one side and what it does on the other,
   then the "updated every semester" note and the access box.
   Opened by any [data-showcase="<slug>"] button (showcase.ts). */
import Icon, { type IconName } from './Icon.astro';
import type { Project } from '../data/projects';

interface Props { project: Project }
const { project: p } = Astro.props;
const sc = p.showcase!;
const id = (t: string) => `sc-${p.slug}-${t}`;
---
<dialog class="showcase" id={`sc-${p.slug}`} aria-labelledby={`sc-${p.slug}-h`}>
  <div class="sc-card">
    <header class="sc-head">
      <div>
        <p class="sc-kicker">project · {p.year} · {p.stack}</p>
        <h3 id={`sc-${p.slug}-h`}>{p.title}</h3>
        <p class="sc-intro">{sc.intro}</p>
      </div>
      <button class="sc-close" type="button" data-close aria-label="Close"><Icon name="close" size={20} /></button>
    </header>

    <div class="sc-tabs" role="tablist" aria-label="Tools">
      {sc.tools.map((t, i) => (
        <button type="button" role="tab" class="sc-tab" id={id(`tab-${t.id}`)} aria-controls={id(t.id)}
          aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>
          <Icon name={t.id as IconName} size={18} />
          <span><b>{t.name}</b><small>{t.course.split(' · ')[0]}</small></span>
        </button>
      ))}
    </div>

    <div class="sc-body">
      {sc.tools.map((t, i) => (
        <section class="sc-tool" role="tabpanel" id={id(t.id)} aria-labelledby={id(`tab-${t.id}`)} hidden={i !== 0}>
          <div class="sc-window">
            <div class="sc-bar" aria-hidden="true">
              <i></i><i></i><i></i>
              <span>{p.slug} / {t.course.split(' · ')[1].toLowerCase().replace(/ /g, '-')} / {t.id}</span>
            </div>
            <img src={t.shots[0].src} alt={t.shots[0].alt} width="800" height="500" loading="lazy" decoding="async" data-main>
            {t.shots.length > 1 && (
              <div class="sc-views" role="group" aria-label={`${t.name} views`}>
                {t.shots.map((s, k) => (
                  <button type="button" aria-pressed={k === 0 ? 'true' : 'false'} data-src={s.src} data-alt={s.alt}>{s.label}</button>
                ))}
              </div>
            )}
          </div>
          <div class="sc-desc">
            <p class="sc-course">{t.course}</p>
            <h4>{t.name}</h4>
            <p>{t.blurb}</p>
            <ul>{t.points.map(pt => <li>{pt}</li>)}</ul>
            <p class="sc-count"><span>{String(i + 1).padStart(2, '0')}</span> / {String(sc.tools.length).padStart(2, '0')}
              {i < sc.tools.length - 1 && <button type="button" class="sc-next" data-goto={i + 1}>next: {sc.tools[i + 1].name} <Icon name="next" size={14} /></button>}
            </p>
          </div>
        </section>
      ))}
    </div>

    <footer class="sc-foot">
      <p class="sc-updates"><Icon name="refresh" size={16} />{sc.updates}</p>
      {p.access && (
        <div class="sc-access">
          <span class="sc-lock"><Icon name="lock" size={16} /></span>
          <p>{p.access.note}</p>
          <a class="btn primary" href={p.access.href} target="_blank" rel="noopener noreferrer"><Icon name="instagram" size={16} />{p.access.cta}</a>
        </div>
      )}
    </footer>
  </div>
</dialog>
