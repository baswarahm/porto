---
/* "my skills": a caption and a moving strip of brand logos, sitting
   between the hero and the first section. */
import { skills } from '../data/skills';
import { logoSvg, brandColor } from '../lib/brand';
---
<div class="wrap">
  <div class="skills-band reveal anim-rise" role="region" aria-label="My skills">
    <p class="skills-cap">my skills</p>
    <ul class="sr-only">{skills.map(s => <li>{s.name}</li>)}</ul>
    <div class="ticker" aria-hidden="true">
      <div class="ticker-track">
        {[0, 1].map(() => skills.map(s => <span class="ticker-item" style={`--brand:${brandColor(s.logo)}`} set:html={logoSvg(s.logo, 22) + `<b>${s.name}</b>`} />))}
      </div>
    </div>
  </div>
</div>
