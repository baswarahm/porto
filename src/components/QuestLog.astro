---
import SectionHead from './SectionHead.astro';
import QuestEntry from './QuestEntry.astro';
import { experience, education } from '../data/experience';

const tabs = [
  { id: 'exp', label: 'Experience', quests: experience },
  { id: 'edu', label: 'Education', quests: education },
];
---
<section class="section container" id="quest-log" aria-labelledby="quest-heading">
  <SectionHead eyebrow="// Quest Log" title="Experience & Education" id="quest-heading"
    desc="Every quest here has been turned in — completed roles, closed competitions, and one degree currently in progress." />

  <div class="quest-tabs" role="tablist" aria-label="Quest log category">
    {tabs.map((t, i) => (
      <button class="quest-tab" role="tab" id={`tab-${t.id}`} aria-selected={i === 0 ? 'true' : 'false'}
        aria-controls={`panel-${t.id}`} tabindex={i === 0 ? undefined : -1}>{t.label}</button>
    ))}
  </div>

  {tabs.map((t, i) => (
    <div class="quest-panel" id={`panel-${t.id}`} role="tabpanel" aria-labelledby={`tab-${t.id}`} hidden={i !== 0}>
      <div class="quest-list quest-timeline">
        {t.quests.map(q => <QuestEntry quest={q} />)}
      </div>
    </div>
  ))}
</section>
