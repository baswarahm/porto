---
import '../styles/theme.css';
import '../styles/style.css';
import '../styles/animation.css';
import '../styles/weather.css';
import '../styles/memory.css';
import '../styles/command-palette.css';
import '../styles/boot.css';
import '../styles/responsive.css';
import { profile, sections } from '../data/profile';

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(profile.avatar, Astro.site);
const navSections = sections.filter(s => s.nav);
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{profile.name}</title>
<meta name="description" content={profile.description}>
<link rel="canonical" href={canonical}>
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<meta name="theme-color" content="#0a0e15">

<meta property="og:type" content="website">
<meta property="og:title" content={profile.name}>
<meta property="og:description" content={profile.description}>
<meta property="og:url" content={canonical}>
<meta property="og:image" content={ogImage}>
<meta name="twitter:card" content="summary">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Rajdhani:wght@500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
</head>
<body>

<div class="boot-overlay" id="bootSequence" hidden aria-hidden="true">
  <div class="boot-phase boot-phase-1" data-phase="1">
    <p class="boot-init mono">INITIALIZING<span class="boot-cursor">_</span></p>
  </div>
  <div class="boot-phase boot-phase-2" data-phase="2">
    <ul class="boot-loglines" id="bootLoglines"></ul>
  </div>
  <div class="boot-phase boot-phase-3" data-phase="3">
    <div class="boot-glow" aria-hidden="true"></div>
    <canvas class="boot-particles" id="bootParticles" aria-hidden="true"></canvas>
    <h2 class="boot-welcome" id="bootWelcome"></h2>
  </div>
  <p class="boot-skip">Click or press any key to skip</p>
</div>

<a class="skip-link" href="#main">Skip to content</a>

<div class="bg-layer bg-aurora" aria-hidden="true"></div>
<div class="bg-layer bg-orbs" aria-hidden="true">
  <span class="orb orb-a"></span>
  <span class="orb orb-b"></span>
  <span class="orb orb-c"></span>
</div>
<div class="bg-layer bg-grid" aria-hidden="true"></div>
<div class="bg-layer bg-scanlines" aria-hidden="true"></div>
<div class="bg-layer bg-weather" id="weatherLayer" aria-hidden="true"><div id="weatherFx"></div></div>
<div class="bg-layer bg-spotlight" id="spotlight" aria-hidden="true"></div>
<canvas id="particle-canvas" aria-hidden="true"></canvas>

<div class="cursor-dot" id="cursorDot" aria-hidden="true"></div>
<div class="cursor-ring" id="cursorRing" aria-hidden="true"></div>

<div class="scroll-progress" id="scrollProgress" aria-hidden="true"></div>

<div class="memory-card" id="memoryCard" role="dialog" aria-label="Welcome back" aria-hidden="true">
  <button class="memory-card-close" id="memoryCardClose" aria-label="Dismiss">×</button>
  <p class="memory-eyebrow mono">// System Memory</p>
  <h3 class="memory-title">Welcome back.</h3>
  <p class="memory-line" id="memoryLastVisit"></p>
  <p class="memory-line" id="memoryVisitCount"></p>
  <div id="memorySections"></div>
  <div class="memory-achievement" id="memoryAchievement" hidden></div>
  <button class="btn btn-primary memory-resume" id="memoryResumeBtn" type="button">Resume Journey</button>
</div>

<nav class="site-nav">
  <div class="nav-inner">
    <a href="#main" class="nav-brand">
      <span class="dot" aria-hidden="true"></span>
      {profile.brand}
    </a>
    <ul class="nav-links" id="navLinks">
      {navSections.map(s => <li><a href={`#${s.id}`}>{s.label}</a></li>)}
    </ul>
    <button type="button" class="nav-cmdk-btn" id="cmdkBtn" aria-label="Open quick nav (Ctrl+K)" title="Quick nav">
      <span aria-hidden="true">⌘K</span>
    </button>
    <a href="#contact" class="nav-cta">Get in touch</a>
  </div>
</nav>

<div class="cmdk-overlay" id="cmdkOverlay" hidden aria-hidden="true">
  <div class="cmdk-panel" role="dialog" aria-modal="true" aria-label="Quick navigation">
    <div class="cmdk-inputrow">
      <span class="cmdk-prompt mono" aria-hidden="true">›</span>
      <input type="text" id="cmdkInput" class="cmdk-input mono" autocomplete="off" spellcheck="false" autocapitalize="off" placeholder="Jump to a section or run a command…" aria-label="Quick nav search">
      <kbd class="cmdk-esc">Esc</kbd>
    </div>
    <ul class="cmdk-list" id="cmdkList" role="listbox"></ul>
  </div>
</div>

<div class="mini-map" id="miniMap" aria-hidden="true">
  {sections.map(s => <a href={`#${s.id}`} data-map={s.id} aria-label={s.label}></a>)}
</div>

<main id="main">
  <slot />
</main>

<footer class="site-footer">
  <div class="container footer-inner">
    <p><span class="footer-name">{profile.name}</span> · {profile.footerRoute}</p>
    <button class="to-top-btn" id="toTopBtn" aria-label="Scroll to top">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><path d="M12 19V5M5 12l7-7 7 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>
  </div>
</footer>

<div class="toast" id="toast" role="status" aria-live="polite">
  <span class="check">✓</span> <span id="toastMsg">Email copied to clipboard</span>
</div>

<div class="matrix-overlay" id="matrixOverlay" aria-hidden="true">
  <canvas id="matrixCanvas"></canvas>
  <p class="matrix-hint mono">MATRIX MODE — press <kbd>Esc</kbd> to exit</p>
</div>

<script is:inline>
  // Safety net: .reveal elements start at opacity:0 until the reveal
  // observer adds .is-visible. If the bundled script fails to load for any
  // reason, force everything visible instead of leaving the page blank.
  setTimeout(function(){
    document.querySelectorAll('.reveal:not(.is-visible)').forEach(function(el){
      el.classList.add('is-visible');
    });
  }, 1500);
</script>
<script>
  import '../scripts/main';
</script>
</body>
</html>
