---
import '../styles/global.css';
import '../styles/interactions.css';
import '../styles/sections.css';
import '../styles/entrances.css';
import '../styles/showcase.css';
import '../styles/pages.css';
import '../styles/one.css';
import '../styles/menu.css';
import StatusLine from '../components/StatusLine.astro';
import Menu from '../components/Menu.astro';
import PageNav from '../components/PageNav.astro';
import { profile, socials, pages } from '../data/profile';
import { degree } from '../data/courses';

interface Props { page?: string }
const { page = 'home' } = Astro.props;
const isHome = page === 'home';
const current = pages.find(p => p.id === page);
// sub-pages get their own title and lead the description with the page name
const title = current ? `${current.title} · ${profile.name}` : profile.pageTitle;
const description = current ? `${current.blurb} ${profile.description}` : profile.description;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(profile.photo, Astro.site);
// schema.org Person, so search engines know whose page this is
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  url: Astro.site?.href,
  image: ogImage.href,
  email: `mailto:${profile.email}`,
  jobTitle: 'Computer Science student',
  description: profile.description,
  homeLocation: { '@type': 'Place', name: 'Penang, Malaysia' },
  birthPlace: { '@type': 'Place', name: 'Surakarta (Solo), Indonesia' },
  affiliation: { '@type': 'CollegeOrUniversity', name: degree.school },
  alumniOf: [{ '@type': 'HighSchool', name: 'SMA Al-Azhar Syifa Budi Solo' }],
  sameAs: socials.map(s => s.href),
};
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonical}>
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="sitemap" href="/sitemap.xml">
<script type="application/ld+json" set:html={JSON.stringify(person)} />
<meta name="theme-color" content="#f1f1ec" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#07080a" media="(prefers-color-scheme: dark)">

<meta property="og:type" content="website">
<meta property="og:title" content={title}>
<meta property="og:site_name" content={profile.name}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonical}>
<meta property="og:image" content={ogImage}>
<meta name="twitter:card" content="summary">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:ital,wght@0,400;0,500;0,600;1,400&family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet">
<script is:inline>
  // apply a saved theme before first paint so there's no flash
  try { var t = localStorage.getItem('theme'); if (t) document.documentElement.dataset.theme = t; } catch (e) {}
  // the site opens straight in (no opening slides)
  document.documentElement.classList.add('no-opening');
</script>
</head>
<body data-page={page}>
  <a class="skip" href="#main">Skip to content</a>
  <Menu page={page} />
  <main id="main">
    <slot />
  </main>
  {!isHome && <PageNav page={page} />}
  <StatusLine />
  <div class="toast" id="toast" role="status" aria-live="polite"></div>
  <div class="pill" id="pill" aria-hidden="true">open ↓</div>
  <div class="sheet" id="sheet" role="dialog" aria-modal="true" aria-labelledby="sheetTitle">
    <div class="sheet-card">
      <header><span id="sheetTitle">keyboard shortcuts</span><button type="button" id="sheetClose" aria-label="Close">esc ✕</button></header>
      <dl id="sheetList"></dl>
    </div>
  </div>
  <script>
    import '../scripts/main';
  </script>
</body>
</html>
