---
import '../styles/global.css';
import '../styles/interactions.css';
import '../styles/sections.css';
import '../styles/entrances.css';
import '../styles/opening.css';
import StatusLine from '../components/StatusLine.astro';
import OpWords from '../components/OpWords.astro';
import { profile, socials } from '../data/profile';
import { degree } from '../data/courses';

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(profile.photo, Astro.site);
// schema.org Person, so search engines know whose page this is
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  url: Astro.site?.href,
  image: ogImage.href,
  email: `mailto:${profile.email}`,
  jobTitle: 'Computer Science student',
  description: profile.description,
  homeLocation: { '@type': 'Place', name: 'Penang, Malaysia' },
  birthPlace: { '@type': 'Place', name: 'Surakarta (Solo), Indonesia' },
  affiliation: { '@type': 'CollegeOrUniversity', name: degree.school },
  alumniOf: [{ '@type': 'HighSchool', name: 'SMA Al-Azhar Syifa Budi Solo' }],
  sameAs: socials.map(s => s.href),
};
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{profile.pageTitle}</title>
<meta name="description" content={profile.description}>
<link rel="canonical" href={canonical}>
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="sitemap" href="/sitemap.xml">
<script type="application/ld+json" set:html={JSON.stringify(person)} />
<meta name="theme-color" content="#f3f0e8" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#121210" media="(prefers-color-scheme: dark)">

<meta property="og:type" content="website">
<meta property="og:title" content={profile.pageTitle}>
<meta property="og:site_name" content={profile.name}>
<meta property="og:description" content={profile.description}>
<meta property="og:url" content={canonical}>
<meta property="og:image" content={ogImage}>
<meta name="twitter:card" content="summary">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:ital,wght@0,400;0,500;0,600;1,400&family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet">
<script is:inline>
  // apply a saved theme before first paint so there's no flash
  try { var t = localStorage.getItem('theme'); if (t) document.documentElement.dataset.theme = t; } catch (e) {}
  // the opening plays once per browser session, never under reduced motion
  try {
    var seen = sessionStorage.getItem('opened') === '1';
    var calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
    document.documentElement.classList.add(seen || calm ? 'no-opening' : 'opening-on');
  } catch (e) { document.documentElement.classList.add('no-opening'); }
</script>
</head>
<body>
  <div class="opening" id="opening" aria-hidden="true">
    <div class="op-track" id="opTrack">
      <div class="op-slide s-welcome">
        <div>
          <p class="op-kicker">hello, visitor</p>
          <p class="op-big"><OpWords text={'Welcome to my'} /><br><OpWords text={'portfolio'} accent /></p>
          <div class="op-rule"></div>
        </div>
      </div>
      <div class="op-slide s-name">
        <div>
          <div class="op-sil"></div>
          <p class="op-kicker">I'm</p>
          <p class="op-big"><OpWords text={profile.nameLines.slice(0, 2).join(' ')} /><br><OpWords text={profile.nameLines[2]} accent /></p>
          <p class="op-sub">first-year computer science student</p>
        </div>
      </div>
      <div class="op-slide s-usm">
        <div>
          <img src="/images/usm-crest.svg" alt="" width="150" height="160" decoding="async">
          <div>
            <p class="op-kicker">studying at</p>
            <p class="op-big"><OpWords text={'Universiti Sains'} /><br><OpWords text={'Malaysia'} accent /></p>
            <p class="op-sub">B.CS · Intelligent Computing — from Surakarta, now in Penang</p>
          </div>
        </div>
      </div>
      <div class="op-slide s-end">
        <div>
          <p class="op-kicker">that's me</p>
          <p class="op-big"><OpWords text={'Enjoy the'} /><OpWords text={'visit.'} accent /></p>
          <p class="op-sub">scroll around, click things, break my name apart — it's all made to be played with.</p>
        </div>
      </div>
    </div>
    <div class="op-dots" id="opDots"><i></i><i></i><i></i><i></i></div>
    <p class="op-skip">click or press any key to skip</p>
  </div>
  <a class="skip" href="#progress">Skip to content</a>
  <slot />
  <StatusLine />
  <div class="toast" id="toast" role="status" aria-live="polite"></div>
  <div class="pill" id="pill" aria-hidden="true">open ↓</div>
  <div class="sheet" id="sheet" role="dialog" aria-modal="true" aria-labelledby="sheetTitle">
    <div class="sheet-card">
      <header><span id="sheetTitle">keyboard shortcuts</span><button type="button" id="sheetClose" aria-label="Close">esc ✕</button></header>
      <dl id="sheetList"></dl>
    </div>
  </div>
  <script>
    import '../scripts/main';
  </script>
</body>
</html>
