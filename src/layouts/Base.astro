---
import '../styles/global.css';
import '../styles/interactions.css';
import '../styles/sections.css';
import StatusLine from '../components/StatusLine.astro';
import { profile } from '../data/profile';

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(profile.photo, Astro.site);
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{profile.handle} — year 1, compiling</title>
<meta name="description" content={profile.description}>
<link rel="canonical" href={canonical}>
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<meta name="theme-color" content="#f3f0e8" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#121210" media="(prefers-color-scheme: dark)">

<meta property="og:type" content="website">
<meta property="og:title" content={profile.name}>
<meta property="og:description" content={profile.description}>
<meta property="og:url" content={canonical}>
<meta property="og:image" content={ogImage}>
<meta name="twitter:card" content="summary">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:ital,wght@0,400;0,500;0,600;1,400&family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet">
<script is:inline>
  // apply a saved theme before first paint so there's no flash
  try { var t = localStorage.getItem('theme'); if (t) document.documentElement.dataset.theme = t; } catch (e) {}
  // the opening plays once per browser session, never under reduced motion
  try {
    var seen = sessionStorage.getItem('opened') === '1';
    var calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
    document.documentElement.classList.add(seen || calm ? 'no-opening' : 'opening-on');
  } catch (e) { document.documentElement.classList.add('no-opening'); }
</script>
</head>
<body>
  <div class="opening" id="opening" aria-hidden="true">
    <pre id="opLog"></pre>
    <div class="op-bar"><span id="opBar"></span></div>
    <p class="op-name" id="opName">{profile.nameLines[0].toLowerCase()}<span>.</span></p>
    <p class="op-skip">click or press any key to skip · <span id="opStyle"></span></p>
  </div>
  <a class="skip" href="#progress">Skip to content</a>
  <slot />
  <StatusLine />
  <div class="toast" id="toast" role="status" aria-live="polite"></div>
  <div class="pill" id="pill" aria-hidden="true">open ↓</div>
  <div class="sheet" id="sheet" role="dialog" aria-modal="true" aria-labelledby="sheetTitle">
    <div class="sheet-card">
      <header><span id="sheetTitle">keyboard shortcuts</span><button type="button" id="sheetClose" aria-label="Close">esc ✕</button></header>
      <dl id="sheetList"></dl>
    </div>
  </div>
  <script>
    import '../scripts/main';
  </script>
</body>
</html>
